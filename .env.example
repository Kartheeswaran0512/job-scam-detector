# Copy to .env and fill in. Restart the server after changing it.

# Google Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tavily API key for the company web search: https://app.tavily.com
# Optional: without it the company check is skipped ("Company web search unavailable").
TAVILY_API_KEY=

# Optional: Gemini model to try first (defaults and fallbacks are in lib/config.js).
# GEMINI_MODEL=gemini-3.5-flash

# Optional: server port (default 5000).
# PORT=5000

# Set to true on Render (or behind any single reverse proxy) so the per-IP rate limit uses each visitor's
# IP instead of the proxy's. Leave unset when visitors connect to the server directly, e.g. running locally:
# then anyone could fake their IP and get around the limit.
# TRUST_PROXY=true
